# Copier en .env et completer. .env n'est jamais commite (voir .gitignore).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# "web" est requis : le front Next relaie ses appels d API vers Django
# en serveur-a-serveur, en presentant le nom du service Docker comme hote.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.24,web

POSTGRES_DB=veille
POSTGRES_USER=veille
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://veille:change-me@db:5432/veille

REDIS_URL=redis://redis:6379/0

# Cle Fernet (32 bytes urlsafe base64) dediee au chiffrement des champs sensibles de la BDC.
# Generer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BDC_ENCRYPTION_KEY=change-me
