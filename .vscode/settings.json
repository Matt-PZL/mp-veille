{
  "files.exclude": {
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.next": true,
    "staticfiles": true,
    "media": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "staticfiles": true,
    "**/package-lock.json": true
  },
  "[python]": { "editor.tabSize": 4 },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
}
